// Asset Service schema. Owned exclusively by asset-service (database `asset_service`).
// CVEs are referenced by their stable CVE ID; CVE facts are a local projection built from
// `cve.record.*` events, never read from the CVE Service database.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum CatalogOrigin {
  curated
  discovered

  @@map("catalog_origin")
}

enum ProductType {
  application
  operating_system @map("operating-system")
  hardware
  unknown

  @@map("product_type")
}

enum ProductIdentifierType {
  purl
  swid
  vendor_sku @map("vendor-sku")
  other

  @@map("product_identifier_type")
}

enum AffectedStatus {
  affected
  unaffected
  unknown

  @@map("affected_status")
}

enum AssociationOrigin {
  observation
  manual

  @@map("association_origin")
}

enum HistoryChange {
  added
  ranges_changed @map("ranges-changed")
  withdrawn
  restored

  @@map("history_change")
}

enum CveState {
  published
  rejected

  @@map("cve_state")
}

enum Severity {
  none
  low
  medium
  high
  critical
  unknown

  @@map("severity")
}

model Vendor {
  id            String        @id @default(uuid()) @db.Uuid
  /// Stable external identifier (CPE-style vendor name); immutable.
  slug          String        @unique @db.VarChar(128)
  name          String        @db.VarChar(128)
  description   String?       @db.VarChar(4000)
  website       String?       @db.VarChar(2048)
  origin        CatalogOrigin @default(curated)
  /// Provenance of the entry: `manual` or the intelligence source that reported it.
  source        String        @db.VarChar(128)
  /// Denormalised counters, recomputed in the transaction that changes them.
  productCount  Int           @default(0) @map("product_count")
  cveCount      Int           @default(0) @map("cve_count")
  /// Optimistic concurrency token, exposed as the ETag.
  version       Int           @default(1)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  products      Product[]

  @@index([name])
  @@index([origin])
  @@index([cveCount(sort: Desc), id])
  @@index([productCount(sort: Desc), id])
  @@map("vendors")
}

model Product {
  id           String              @id @default(uuid()) @db.Uuid
  vendorId     String              @map("vendor_id") @db.Uuid
  /// Stable external identifier, unique per vendor (CPE-style product name); immutable.
  slug         String              @db.VarChar(128)
  name         String              @db.VarChar(128)
  type         ProductType         @default(unknown)
  description  String?             @db.VarChar(4000)
  website      String?             @db.VarChar(2048)
  origin       CatalogOrigin       @default(curated)
  source       String              @db.VarChar(128)
  cveCount     Int                 @default(0) @map("cve_count")
  version      Int                 @default(1)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendor       Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  cpes         ProductCpe[]
  identifiers  ProductIdentifier[]
  associations CveProductAssociation[]
  history      ProductVulnerabilityHistory[]

  @@unique([vendorId, slug])
  @@index([name])
  @@index([type])
  @@index([origin])
  @@index([cveCount(sort: Desc), id])
  @@map("products")
}

/// CPE 2.3 names registered for a product. Each name belongs to at most one product, so CPE
/// matching is unambiguous. The parsed components are indexed for matching by part/vendor/product.
model ProductCpe {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  cpe        String   @unique @db.VarChar(512)
  part       String   @db.VarChar(1)
  cpeVendor  String   @map("cpe_vendor") @db.VarChar(256)
  cpeProduct String   @map("cpe_product") @db.VarChar(256)
  cpeVersion String   @map("cpe_version") @db.VarChar(256)
  source     String   @db.VarChar(128)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cpeVendor, cpeProduct])
  @@index([productId])
  @@map("product_cpes")
}

/// Other identifiers of a product (Package URL, SWID tag ID, vendor SKU, …).
model ProductIdentifier {
  id        String                @id @default(uuid()) @db.Uuid
  productId String                @map("product_id") @db.Uuid
  type      ProductIdentifierType
  value     String                @db.VarChar(512)
  source    String                @db.VarChar(128)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([value])
  @@index([productId])
  @@map("product_identifiers")
}

/// A CVE affects (or explicitly does not affect) a product, according to one source item.
/// Associations are never deleted when a source stops reporting them: `withdrawn_at` is set, so
/// the product's vulnerability history stays complete.
model CveProductAssociation {
  id             String                 @id @default(uuid()) @db.Uuid
  cveId          String                 @map("cve_id") @db.VarChar(32)
  productId      String                 @map("product_id") @db.Uuid
  /// Denormalised from the product so vendor analytics need no join through products.
  vendorId       String                 @map("vendor_id") @db.Uuid
  source         String                 @db.VarChar(128)
  sourceRecordId String                 @map("source_record_id") @db.VarChar(128)
  sourceUrl      String?                @map("source_url") @db.VarChar(2048)
  attribution    String?                @db.VarChar(512)
  origin         AssociationOrigin
  status         AffectedStatus
  note           String?                @db.VarChar(2000)
  firstSeenAt    DateTime               @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt     DateTime               @map("last_seen_at") @db.Timestamptz(3)
  withdrawnAt    DateTime?              @map("withdrawn_at") @db.Timestamptz(3)

  product        Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  ranges         AffectedVersionRange[]
  history        ProductVulnerabilityHistory[]

  @@unique([cveId, productId, source, sourceRecordId])
  @@index([productId, withdrawnAt])
  @@index([vendorId, withdrawnAt])
  @@index([cveId])
  @@index([source, sourceRecordId])
  @@map("cve_product_associations")
}

model AffectedVersionRange {
  id                    String                @id @default(uuid()) @db.Uuid
  associationId         String                @map("association_id") @db.Uuid
  /// Canonical JSON of the range, for duplicate detection.
  rangeKey              String                @map("range_key") @db.VarChar(1400)
  status                AffectedStatus
  cpe                   String?               @db.VarChar(512)
  version               String?               @db.VarChar(128)
  versionStartIncluding String?               @map("version_start_including") @db.VarChar(128)
  versionStartExcluding String?               @map("version_start_excluding") @db.VarChar(128)
  versionEndIncluding   String?               @map("version_end_including") @db.VarChar(128)
  versionEndExcluding   String?               @map("version_end_excluding") @db.VarChar(128)

  association           CveProductAssociation @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@unique([associationId, rangeKey])
  @@map("affected_version_ranges")
}

/// Append-only timeline of association changes per product.
model ProductVulnerabilityHistory {
  id             String                @id @default(uuid()) @db.Uuid
  productId      String                @map("product_id") @db.Uuid
  associationId  String                @map("association_id") @db.Uuid
  cveId          String                @map("cve_id") @db.VarChar(32)
  change         HistoryChange
  source         String                @db.VarChar(128)
  sourceRecordId String                @map("source_record_id") @db.VarChar(128)
  /// Version ranges after the change (before it for `withdrawn`).
  ranges         Json
  occurredAt     DateTime              @map("occurred_at") @db.Timestamptz(3)

  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  association    CveProductAssociation @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([productId, occurredAt(sort: Desc), id])
  @@index([cveId])
  @@map("product_vulnerability_history")
}

/// Last applied observation revision per intelligence source item; older revisions are ignored.
model ObservationCursor {
  id             String   @id @default(uuid()) @db.Uuid
  source         String   @db.VarChar(128)
  sourceRecordId String   @map("source_record_id") @db.VarChar(128)
  cveId          String   @map("cve_id") @db.VarChar(32)
  revision       Int
  contentHash    String   @map("content_hash") @db.Char(64)
  observedAt     DateTime @map("observed_at") @db.Timestamptz(3)
  appliedAt      DateTime @map("applied_at") @db.Timestamptz(3)

  @@unique([source, sourceRecordId])
  @@index([cveId])
  @@map("observation_cursors")
}

/// Local projection of CVE facts from `cve.record.*` events (event-carried state transfer).
model CveFact {
  id               String    @id @default(uuid()) @db.Uuid
  cveId            String    @unique @map("cve_id") @db.VarChar(32)
  /// CVE Service record ID and version of the last applied event, for ordering.
  recordId         String    @map("record_id") @db.Uuid
  recordVersion    Int       @map("record_version")
  state            CveState
  severity         Severity
  cvssScore        Decimal?  @map("cvss_score") @db.Decimal(3, 1)
  inKev            Boolean   @map("in_kev")
  epssScore        Decimal?  @map("epss_score") @db.Decimal(10, 9)
  epssPercentile   Decimal?  @map("epss_percentile") @db.Decimal(10, 9)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(3)
  /// Set when the CVE Service deleted the record; the row stays as a tombstone for ordering.
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  eventOccurredAt  DateTime  @map("event_occurred_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([severity])
  @@map("cve_facts")
}

/// Inbox: events already applied per consumer, written in the same transaction as the change.
model ProcessedEvent {
  id          String   @id @default(uuid()) @db.Uuid
  consumer    String   @db.VarChar(64)
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@unique([consumer, eventId])
  @@index([processedAt])
  @@map("processed_events")
}

/// Transactional outbox for domain events (published by OutboxRelay).
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @unique @map("event_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(128)
  envelope      Json
  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.VarChar(2000)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([publishedAt, nextAttemptAt])
  @@map("outbox_events")
}
