{
  "name": "@cve/security",
  "version": "0.1.0",
  "private": true,
  "description": "Security defaults: HTTP headers, CORS and request identifiers.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "@types/express": "^5.0.6",
    "@cve/contracts": "workspace:*",
    "express": "^5.3.0"
  }
}
