{
  "name": "@cve/logger",
  "version": "0.1.0",
  "private": true,
  "description": "Structured Pino logging and NestJS logger adapter.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "@nestjs/common": "^12.3.2",
    "pino-pretty": "^13.2.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "pino-pretty": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    }
  }
}
