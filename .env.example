# Copy to `.env` and replace every `change-me-*` value before starting the stack.
# Passwords are embedded in connection URLs, so use URL-safe values, e.g. `openssl rand -hex 24`.
# Never commit `.env`.

# ---- Shared application settings
LOG_LEVEL=info
SWAGGER_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- PostgreSQL (superuser is used only by the init script and for administration)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres

# One database and role per service (database ownership, CLAUDE.md §4 and §11)
IDENTITY_SERVICE_DB_PASSWORD=change-me-identity
CVE_SERVICE_DB_PASSWORD=change-me-cve
INTELLIGENCE_SERVICE_DB_PASSWORD=change-me-intelligence
ASSET_SERVICE_DB_PASSWORD=change-me-asset
POC_SERVICE_DB_PASSWORD=change-me-poc
DOWNLOAD_SERVICE_DB_PASSWORD=change-me-download
EXPLOIT_SERVICE_DB_PASSWORD=change-me-exploit
REPORTING_SERVICE_DB_PASSWORD=change-me-reporting
NOTIFICATION_SERVICE_DB_PASSWORD=change-me-notification
KEYCLOAK_DB_PASSWORD=change-me-keycloak

# ---- Redis
REDIS_PASSWORD=change-me-redis

# ---- RabbitMQ
RABBITMQ_USER=cve_platform
RABBITMQ_PASSWORD=change-me-rabbitmq

# ---- OpenSearch (must be strong: 8+ chars with upper, lower, digit and symbol)
OPENSEARCH_ADMIN_PASSWORD=Change-me-0pensearch!

# ---- MinIO (root credentials are for administration only; services get scoped users in Phase 6)
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MINIO_ROOT_USER=cve-minio-admin
MINIO_ROOT_PASSWORD=change-me-minio

# ---- Keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# ---- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---- Local development (`pnpm dev`): services read these from the repository root `.env`.
# They point at the infrastructure ports published on 127.0.0.1 by `docker compose up -d`.
# Each service process must use its own DATABASE_URL; set them in services/<name>/.env, e.g.
#   services/cve-service/.env:
#   DATABASE_URL=postgresql://cve_service:change-me-cve@localhost:5432/cve_service
REDIS_URL=redis://:change-me-redis@localhost:6379
RABBITMQ_URL=amqp://cve_platform:change-me-rabbitmq@localhost:5672
API_GATEWAY_INTERNAL_URL=http://localhost:4000
IDENTITY_SERVICE_URL=http://localhost:4001
CVE_SERVICE_URL=http://localhost:4002
INTELLIGENCE_SERVICE_URL=http://localhost:4003
ASSET_SERVICE_URL=http://localhost:4004
POC_SERVICE_URL=http://localhost:4005
DOWNLOAD_SERVICE_URL=http://localhost:4006
EXPLOIT_SERVICE_URL=http://localhost:4007
REPORTING_SERVICE_URL=http://localhost:4008
NOTIFICATION_SERVICE_URL=http://localhost:4009
