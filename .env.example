# CVE Intelligence Platform — environment template.
#
#   pnpm env:generate     # writes .env with random secrets (and services/*/.env for `pnpm dev`)
#
# Every value that starts with `change-me` is a secret: `pnpm env:generate` replaces it with
# 48 random hex characters. Secrets must be at least 16 characters and URL-safe because they
# are embedded in connection URLs. Never commit `.env`.
#
# Each service has its own credentials for every backing store (CLAUDE.md §8, least privilege).

# ---- Shared application settings
LOG_LEVEL=info
SWAGGER_ENABLED=false
# Public origin of the platform (Nginx). Used for CORS, Keycloak redirect URIs and Grafana.
PUBLIC_ORIGIN=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ---- PostgreSQL
# The superuser is used only by the init script and for administration.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
# One database and login role per service (CLAUDE.md §4, §11).
IDENTITY_SERVICE_DB_PASSWORD=change-me
CVE_SERVICE_DB_PASSWORD=change-me
INTELLIGENCE_SERVICE_DB_PASSWORD=change-me
ASSET_SERVICE_DB_PASSWORD=change-me
POC_SERVICE_DB_PASSWORD=change-me
DOWNLOAD_SERVICE_DB_PASSWORD=change-me
EXPLOIT_SERVICE_DB_PASSWORD=change-me
REPORTING_SERVICE_DB_PASSWORD=change-me
NOTIFICATION_SERVICE_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
# pg_monitor role used by postgres-exporter.
POSTGRES_EXPORTER_PASSWORD=change-me

# ---- Redis (ACL users; the default user is disabled)
REDIS_ADMIN_PASSWORD=change-me
REDIS_EXPORTER_PASSWORD=change-me
IDENTITY_SERVICE_REDIS_PASSWORD=change-me
CVE_SERVICE_REDIS_PASSWORD=change-me
INTELLIGENCE_SERVICE_REDIS_PASSWORD=change-me
ASSET_SERVICE_REDIS_PASSWORD=change-me
POC_SERVICE_REDIS_PASSWORD=change-me
DOWNLOAD_SERVICE_REDIS_PASSWORD=change-me
EXPLOIT_SERVICE_REDIS_PASSWORD=change-me
REPORTING_SERVICE_REDIS_PASSWORD=change-me
NOTIFICATION_SERVICE_REDIS_PASSWORD=change-me

# ---- RabbitMQ (administrator + one user per service on the `cve` vhost)
RABBITMQ_ADMIN_USER=cve-admin
RABBITMQ_ADMIN_PASSWORD=change-me
IDENTITY_SERVICE_RABBITMQ_PASSWORD=change-me
CVE_SERVICE_RABBITMQ_PASSWORD=change-me
INTELLIGENCE_SERVICE_RABBITMQ_PASSWORD=change-me
ASSET_SERVICE_RABBITMQ_PASSWORD=change-me
POC_SERVICE_RABBITMQ_PASSWORD=change-me
DOWNLOAD_SERVICE_RABBITMQ_PASSWORD=change-me
EXPLOIT_SERVICE_RABBITMQ_PASSWORD=change-me
REPORTING_SERVICE_RABBITMQ_PASSWORD=change-me
NOTIFICATION_SERVICE_RABBITMQ_PASSWORD=change-me

# ---- OpenSearch (TLS with a locally generated CA; only the CVE Service has a user)
OPENSEARCH_ADMIN_PASSWORD=change-me
OPENSEARCH_KEYSTORE_PASSWORD=change-me
CVE_SERVICE_OPENSEARCH_PASSWORD=change-me

# ---- MinIO (root is for administration only; services use scoped users)
# The upstream project no longer publishes images on Docker Hub; see docs/infrastructure.md.
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MINIO_ROOT_USER=cve-minio-admin
MINIO_ROOT_PASSWORD=change-me
DOWNLOAD_SERVICE_MINIO_SECRET_KEY=change-me
POC_SERVICE_MINIO_SECRET_KEY=change-me
REPORTING_SERVICE_MINIO_SECRET_KEY=change-me

# ---- Keycloak
KEYCLOAK_ADMIN_USER=kc-admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_API_CLIENT_SECRET=change-me
KEYCLOAK_IDENTITY_SERVICE_CLIENT_SECRET=change-me

# ---- Web frontend (backend-for-frontend)
# Encrypts the httpOnly session cookie that holds the user's tokens (AES-256-GCM, HKDF).
# At least 32 characters. Rotating it signs every user out.
WEB_SESSION_SECRET=change-me

# ---- External intelligence sources (Intelligence Service and PoC Service)
# Optional credentials; the sources work without them at lower quotas. Never commit real values.
# NVD API key (https://nvd.nist.gov/developers/request-an-api-key): 50 instead of 5 requests / 30 s.
NVD_API_KEY=
# GitHub token without any scopes or permissions (public advisories and public repository metadata):
# 5 000 instead of 60 core requests / h and 30 instead of 10 search requests / min.
GITHUB_TOKEN=

# ---- Exploit catalogs (Exploit Service): metadata only, exploit code is never downloaded or run.
# Comma-separated list of metasploit and exploit-db, or "none". Exploit-DB is off by default:
# review its terms of use (https://www.exploit-db.com/terms) before enabling it.
EXPLOIT_CATALOGS_ENABLED=metasploit

# ---- Grafana
GRAFANA_ADMIN_USER=grafana-admin
GRAFANA_ADMIN_PASSWORD=change-me
