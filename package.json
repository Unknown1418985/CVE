{
  "name": "cve-intelligence-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted CVE Intelligence Platform (TypeScript monorepo).",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compose:config": "docker compose --env-file .env.example config --quiet && docker compose --env-file .env.example -f compose.yaml -f compose.dev.yaml --profile apps --profile observability config --quiet",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "env:generate": "pnpm --filter @cve/infra-provisioner build && node tools/infra-provisioner/dist/generate-env.js",
    "test:integration": "turbo run test:integration --concurrency=1",
    "infra:wait": "pnpm --filter @cve/infra-provisioner build && node tools/infra-provisioner/dist/wait-for-stack.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.5",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jiti": "^2.4.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
